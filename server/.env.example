PORT=3001
# Mínimo 32 caracteres. No uses el valor de ejemplo en producción.
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
DATABASE_URL=mongodb+srv://usuario:password@cluster.mongodb.net/AR?retryWrites=true&w=majority

# Orígenes del frontend (separados por coma). En producción usa HTTPS.
CORS_ORIGIN=http://localhost:5173

# production → cookies Secure + HSTS. Requiere HTTPS detrás de nginx/Certbot.
# NODE_ENV=production

# true = permite POST /api/auth/register. En producción queda deshabilitado si no se define.
# ALLOW_REGISTER=true

# Logging: trace | debug | info | warn | error (default: info en prod, debug en dev)
# LOG_LEVEL=info

# Edad mínima (horas) de un archivo huérfano antes de eliminarlo (default: 1)
# UPLOAD_ORPHAN_MIN_AGE_HOURS=1

# Intervalo de limpieza automática de huérfanos (ms). Default: 6 horas.
# UPLOAD_ORPHAN_CLEANUP_INTERVAL_MS=21600000

# Cuota de subida por usuario autenticado por ventana de 15 min (bytes). Default: 40 MB.
# UPLOAD_USER_QUOTA_BYTES=41943040

# Tope global del directorio uploads (bytes). Default: 2 GB.
# UPLOAD_GLOBAL_QUOTA_BYTES=2147483648

# Dimensión máxima (px) permitida al validar imágenes.
# UPLOAD_MAX_IMAGE_DIMENSION=10000

# Timeout de consultas de búsqueda de clientes (ms).
# CLIENT_SEARCH_MAX_TIME_MS=2000

# Timeout de apagado graceful en ms (default: 10000)
# SHUTDOWN_TIMEOUT_MS=10000
