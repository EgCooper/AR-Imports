PORT=3001
# Mínimo 32 caracteres. No uses el valor de ejemplo en producción.
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio
DATABASE_URL=mongodb+srv://usuario:password@cluster.mongodb.net/AR?retryWrites=true&w=majority

# Orígenes del frontend (separados por coma). En producción usa HTTPS.
CORS_ORIGIN=http://localhost:5173

# production → cookies Secure + HSTS. Requiere HTTPS detrás de nginx/Certbot.
# NODE_ENV=production

# true = permite POST /api/auth/register. En producción queda deshabilitado si no se define.
# ALLOW_REGISTER=true

# Logging: trace | debug | info | warn | error (default: info en prod, debug en dev)
# LOG_LEVEL=info

# Edad mínima (horas) de un archivo huérfano antes de eliminarlo (default: 24)
# UPLOAD_ORPHAN_MIN_AGE_HOURS=24

# Timeout de apagado graceful en ms (default: 10000)
# SHUTDOWN_TIMEOUT_MS=10000
